node_modules/
dist/
.next/
out/
coverage/

# No bare `build/` here. It would match the `src/app/build/` route directory and silently
# un-commit the app's main page — which is exactly what happened once. Build output lives in
# out/, .next/ and .wrangler/, all covered above.

# wrangler
.wrangler/
.dev.vars

# env
.env
.env.local
.env.*.local

# editors / os
.DS_Store
Thumbs.db
.idea/
*.swp

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# tooling caches
*.tsbuildinfo
.eslintcache
